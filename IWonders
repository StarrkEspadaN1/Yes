using System;

namespace SevenWonders
{
    public abstract class Wonder
    {
        public string Name { get; protected set; }
        public string Location { get; protected set; }
        public abstract void ShowInfo();
    }

    public class GreatPyramid : Wonder
    {
        public GreatPyramid()
        {
            Name = "Пирамида Хеопса";
            Location = "Гиза, Египет";
        }
        public override void ShowInfo() => Console.WriteLine($"{Name} – {Location}. Единственное сохранившееся чудо.");
    }

    public class HangingGardens : Wonder
    {
        public HangingGardens()
        {
            Name = "Висячие сады Семирамиды";
            Location = "Вавилон, Ирак";
        }
        public override void ShowInfo() => Console.WriteLine($"{Name} – {Location}. Существование не доказано.");
    }

    public class StatueOfZeus : Wonder
    {
        public StatueOfZeus()
        {
